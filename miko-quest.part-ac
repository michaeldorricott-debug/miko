", "countdown": "data:audio/mp3;base64,", "victory": "data:audio/mp3;base64,"};
  // Map scene id (+ CURRENT_STOP for scene-stop) to a music key in SCENE_MUSIC
  function _sceneMusicKey(sceneId) {
    if (sceneId === 'scene-stop') {
      if (CURRENT_STOP === 'cat')   return 'cat';
      if (CURRENT_STOP === 'manmo') return 'manmo';
      if (CURRENT_STOP === 'peak')  return 'peak';
      if (CURRENT_STOP === 'clock') return 'clock';
    }
    if (sceneId === 'scene-dimsum')    return 'dimsum';
    if (sceneId === 'scene-artifact')  return 'artifact';
    if (sceneId === 'scene-countdown') return 'countdown';
    if (sceneId === 'scene-victory')   return 'victory';
    return null;
  }
  let _sceneMusicEl = null;
  let _sceneMusicCurrentKey = null;
  function _sceneAudioEl() {
    if (!_sceneMusicEl) {
      _sceneMusicEl = document.createElement('audio');
      _sceneMusicEl.id = 'sceneMusic';
      _sceneMusicEl.loop = true;
      _sceneMusicEl.volume = 0;
      document.body.appendChild(_sceneMusicEl);
    }
    return _sceneMusicEl;
  }
  function playSceneMusic(key) {
    if (!key || !SCENE_MUSIC[key]) { fadeOutSceneMusic(); return; }
    if (_sceneMusicCurrentKey === key && _sceneMusicEl && !_sceneMusicEl.paused) return; // already playing
    const a = _sceneAudioEl();
    a.pause();
    _sceneMusicCurrentKey = key;
    a.src = SCENE_MUSIC[key];
    a.currentTime = 0;
    a.play().then(() => {
      const targetVol = (key === 'victory') ? 0.38 : (key === 'countdown' ? 0.42 : 0.35);
      const step = targetVol / 22;
      let v = 0;
      a.volume = 0;
      const fade = setInterval(() => {
        v += step;
        if (v >= targetVol) { v = targetVol; clearInterval(fade); }
        a.volume = v;
      }, 80);
    }).catch(err => console.warn('Scene music play failed:', err));
  }
  function fadeOutSceneMusic() {
    if (!_sceneMusicEl || _sceneMusicEl.paused) { _sceneMusicCurrentKey = null; return; }
    _sceneMusicCurrentKey = null;
    const a = _sceneMusicEl;
    const step = (a.volume || 0.35) / 18;
    const interval = setInterval(() => {
      if (a.volume <= step) { a.volume = 0; a.pause(); clearInterval(interval); }
      else a.volume -= step;
    }, 70);
  }

  // Map of scene "key" → audio key. CURRENT_STOP drives stop congrats.
  function _ddAudioKey(scene) {
    if (scene === 'letter1' || scene === 'letter2' || scene === 'sorting' || scene === 'victory' || scene === 'preBattle') return scene;
    if (scene === 'ddOverlay') {
      if (CURRENT_STOP === 'cat')   return 'cat';
      if (CURRENT_STOP === 'manmo') return 'manmo';
      if (CURRENT_STOP === 'peak')  return 'peak';
      if (CURRENT_STOP === 'clock') return 'clock';
    }
    if (scene === 'mapNarration') {
      if (NEXT_STOP === 'final' || !NEXT_STOP) return 'map_final';
      return 'map_' + NEXT_STOP;
    }
    if (scene === 'dobbyDimSum')       return 'dobby_dim_sum';
    if (scene === 'dobbyGreeting')     return 'dobby_greeting';
    if (scene === 'dobbyOverlay') {
      if (CURRENT_STOP === 'cat')   return 'dobby_cat_to_manmo';
      if (CURRENT_STOP === 'manmo') return 'dobby_manmo_to_peak';
      if (CURRENT_STOP === 'peak')  return 'dobby_peak_to_clock';
    }
    return null;
  }

  // Returns a shared <audio> element (one for the whole app)
  function _ddSharedAudio() {
    let a = document.getElementById('ddAudioShared');
    if (!a) {
      a = document.createElement('audio');
      a.id = 'ddAudioShared';
      a.preload = 'none';
      document.body.appendChild(a);
    }
    return a;
  }

  // Map of button ID → which scene it belongs to (for resetting between scenes)
  const _ddBtnIds = ['letterAudioBtn', 'sortingAudioBtn', 'ddOverlayAudioBtn', 'victoryAudioBtn', 'mapNarrationAudioBtn', 'dimsumDobbyAudioBtn', 'dobbyOverlayAudioBtn', 'dobbyGreetingAudioBtn', 'preBattleAudioBtn'];

  function _ddSpeakerFor(btnId) {
    // Buttons with "obby" or "Dobby" in the ID are for Dobby; rest = Dumbledore
    return /obby/i.test(btnId) ? 'DOBBY' : 'DUMBLEDORE';
  }

  function _ddResetBtn(btnId) {
    const btn = document.getElementById(btnId);
    if (!btn) return;
    btn.classList.remove('playing');
    const icon = btn.querySelector('.letter-audio-icon');
    const label = btn.querySelector('.letter-audio-label');
    if (icon) icon.textContent = '▶';
    if (label) label.textContent = 'HEAR ' + _ddSpeakerFor(btnId);
  }

  function _ddResetAllBtns() {
    _ddBtnIds.forEach(_ddResetBtn);
  }

  function loadLetterAudio(page) {
    // Stop anything playing
    const a = _ddSharedAudio();
    a.pause();
    a.currentTime = 0;
    _ddResetAllBtns();
    // Update letter button visibility
    const btn = document.getElementById('letterAudioBtn');
    const key = page === 1 ? 'letter1' : 'letter2';
    if (btn) btn.style.display = DD_AUDIO[key] ? '' : 'none';
  }

  // Generic toggle: pass the scene key + button id
  function _ddToggle(sceneKey, btnId) {
    const a = _ddSharedAudio();
    const key = _ddAudioKey(sceneKey);
    if (!key || !DD_AUDIO[key]) return;
    const btn = document.getElementById(btnId);
    const icon = btn.querySelector('.letter-audio-icon');
    const label = btn.querySelector('.letter-audio-label');
    const speaker = _ddSpeakerFor(btnId);
    // If audio is playing this scene, pause it
    if (!a.paused && a.dataset.activeKey === key) {
      a.pause();
      btn.classList.remove('playing');
      icon.textContent = '▶';
      label.textContent = 'HEAR ' + speaker;
      duckOpeningMusic(false);
      return;
    }
    // Otherwise reset all buttons, swap src, and play
    _ddResetAllBtns();
    a.src = DD_AUDIO[key];
    a.dataset.activeKey = key;
    a.currentTime = 0;
    duckOpeningMusic(true);
    a.play().then(() => {
      btn.classList.add('playing');
      icon.textContent = '⏸';
      label.textContent = speaker + ' SPEAKS…';
    }).catch(err => {
      console.warn('Audio play failed:', err);
      label.textContent = 'TAP AGAIN';
    });
    // Reset button on end + restore opening music volume
    a.onended = () => {
      btn.classList.remove('playing');
      icon.textContent = '▶';
      label.textContent = 'PLAY AGAIN';
      duckOpeningMusic(false);
    };
  }


  function toggleMapNarrationAudio()  { _ddToggle('mapNarration',  'mapNarrationAudioBtn'); }
  function toggleDimsumDobbyAudio()   { _ddToggle('dobbyDimSum',   'dimsumDobbyAudioBtn'); }
  function toggleDobbyOverlayAudio()  { _ddToggle('dobbyOverlay',  'dobbyOverlayAudioBtn'); }
  function toggleDobbyGreetingAudio() { _ddToggle('dobbyGreeting', 'dobbyGreetingAudioBtn'); }


  function togglePreBattleAudio()    { _ddToggle('preBattle',    'preBattleAudioBtn'); }

  function openPreBattle() {
    // Show overlay with Dumbledore portrait
    const portrait = document.querySelector('.dumbledore-portrait, .dd-avatar, .dd-big-portrait, .sorting-dd-portrait');
    if (portrait && portrait.src) document.getElementById('preBattlePortrait').src = portrait.src;
    // Hide audio button if no audio yet
    const audioBtn = document.getElementById('preBattleAudioBtn');
    if (audioBtn) audioBtn.style.display = DD_AUDIO.preBattle ? '' : 'none';
    document.getElementById('preBattleOverlay').classList.add('show');
  }
  function closePreBattle() {
    // Stop any DD audio that was playing
    const a = document.getElementById('ddAudioShared');
    if (a) a.pause();
    _ddResetAllBtns();
    document.getElementById('preBattleOverlay').classList.remove('show');
    startBattle();
  }

  // --- BATTLE BACKGROUND MUSIC ---
  let _battleMusicEl = null;
  function startBattleMusic() {
    if (!BATTLE_MUSIC) return;
    if (!_battleMusicEl) {
      _battleMusicEl = document.createElement('audio');
      _battleMusicEl.id = 'battleMusic';
      _battleMusicEl.loop = true;
      _battleMusicEl.volume = 0;
      document.body.appendChild(_battleMusicEl);
    }
    _battleMusicEl.src = BATTLE_MUSIC;
    _battleMusicEl.currentTime = 0;
    _battleMusicEl.play().then(() => {
      // Fade in over 2 seconds
      const targetVol = 0.45;
      const step = targetVol / 20;
      let v = 0;
      const fade = setInterval(() => {
        v += step;
        if (v >= targetVol) { v = targetVol; clearInterval(fade); }
        _battleMusicEl.volume = v;
      }, 100);
    }).catch(err => console.warn('Battle music play failed:', err));
  }
  // --- OPENING MUSIC (cold scene + letter scene) ---
  function startOpeningMusic() {
    if (!OPENING_MUSIC) return;
    if (!_openingMusicEl) {
      _openingMusicEl = document.createElement('audio');
      _openingMusicEl.id = 'openingMusic';
      _openingMusicEl.loop = true;
      _openingMusicEl.volume = 0;
      document.body.appendChild(_openingMusicEl);
    }
    if (!_openingMusicEl.paused) return;  // already playing
    _openingMusicEl.src = OPENING_MUSIC;
    _openingMusicEl.play().then(() => {
      const targetVol = 0.32;
      const step = targetVol / 25;
      let v = _openingMusicEl.volume;
      const fade = setInterval(() => {
        v += step;
        if (v >= targetVol) { v = targetVol; clearInterval(fade); }
        _openingMusicEl.volume = v;
      }, 80);
    }).catch(err => console.warn('Opening music play failed:', err));
  }
  function stopOpeningMusic(fade) {
    if (!_openingMusicEl) return;
    if (!fade) { _openingMusicEl.pause(); _openingMusicEl.volume = 0; return; }
    const step = (_openingMusicEl.volume || 0.32) / 18;
    const interval = setInterval(() => {
      if (_openingMusicEl.volume <= step) {
        _openingMusicEl.volume = 0;
        _openingMusicEl.pause();
        clearInterval(interval);
      } else {
        _openingMusicEl.volume -= step;
      }
    }, 80);
  }
  function duckOpeningMusic(low) {
    // Lower (or raise) ALL background music volume so DD/Dobby voice plays clearly on top
    if (_openingMusicEl && !_openingMusicEl.paused) {
      _openingMusicEl.volume = low ? 0.08 : 0.32;
    }
    if (typeof _sceneMusicEl !== 'undefined' && _sceneMusicEl && !_sceneMusicEl.paused) {
      _sceneMusicEl.volume = low ? 0.08 : 0.35;
    }
  }

  function stopBattleMusic(fade) {
    if (!_battleMusicEl) return;
    if (!fade) { _battleMusicEl.pause(); _battleMusicEl.volume = 0; return; }
    const startVol = _battleMusicEl.volume;
    const step = startVol / 20;
    const interval = setInterval(() => {
      if (_battleMusicEl.volume <= step) { _battleMusicEl.volume = 0; _battleMusicEl.pause(); clearInterval(interval); }
      else _battleMusicEl.volume -= step;
    }, 80);
  }

  function toggleLetterAudio()   { _ddToggle(currentLetterPage(), 'letterAudioBtn'); }
  function toggleSortingAudio()  { _ddToggle('sorting',           'sortingAudioBtn'); }
  function toggleDDOverlayAudio(){ _ddToggle('ddOverlay',         'ddOverlayAudioBtn'); }
  function toggleVictoryAudio()  { _ddToggle('victory',           'victoryAudioBtn'); }

  function currentLetterPage() {
    // Page indicator reads e.g. "1 / 2" or "2 / 2" — use the FIRST digit only.
    const ind = document.getElementById('letterPageIndicator');
    if (ind && ind.textContent.trim().startsWith('2')) return 'letter2';
    return 'letter1';
  }

  // Stop all DD audio whenever the scene changes (via show())
  function stopDDAudio() {
    const a = document.getElementById('ddAudioShared');
    if (a) a.pause();
    _ddResetAllBtns();
    duckOpeningMusic(false);
  }

  // Scene 2 letter pagination
  function letterPage(n) {
    document.querySelectorAll('.letter-page').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.letter-page-' + n).forEach(p => p.classList.add('active'));
    loadLetterAudio(n);
    document.getElementById('letterPageIndicator').textContent = n + ' / 2';
    document.getElementById('letterPrevBtn').disabled = (n === 1);
    document.getElementById('letterNextBtn').style.display = (n === 1) ? 'inline-block' : 'none';
    document.getElementById('letterContinueBtn').style.display = (n === 2) ? 'inline-block' : 'none';
    const p = document.getElementById('parchment');
    if (p) p.scrollTop = 0;
  }

  // Scene 2 → 3
  function goToRules() {
    // Clear any letter touching/state
    const p = document.getElementById('parchment');
    if (p) p.classList.remove('touching');
    show('scene-rules');
    // Defensive: ensure rules-parchment is visible (in case any leftover state)
    setTimeout(() => {
      const rp = document.querySelector('#scene-rules .rules-parchment');
      if (rp) {
        rp.style.display = 'block';
        rp.style.opacity = '1';
        rp.style.visibility = 'visible';
      }
    }, 50);
  }

  // Dobby tap
  function dobbyTap() {
    const bubble = document.getElementById('dobbyBubble');
    const messages = [
      "<strong>Dobby</strong> says: read the three laws carefully, Master Miko!",
      "<strong>Dobby</strong> whispers: scroll down for all three laws!",
      "<strong>Dobby</strong> twitches his ears: when ready, tap 'I AM READY'!",
      "<strong>Dobby</strong> is here to help! Tap me again if Master needs reminders.",
    ];
    bubble.innerHTML = messages[Math.floor(Math.random() * messages.length)];
  }

  // Scene 3 → 4 (Map)
  function goToMap() {
    show('scene-map');
  
    updateMapNarration();
  }
  function goBackToMap() {
    show('scene-map');
  
    updateMapNarration();
  }

  // --- STOP DATA ---
  const STOPS = {
    cat: {
      tag: 'THE FIRST SACRED PLACE',
      title: 'Cat Street',
      image: 'data:image/jpeg;base64,',
      mapNarration: "Your first destination calls to you from the southern shore — Sheung Wan's Cat Street, where the merchants once hid more than antiques in the lanes. Tap the glowing mark.",
      cn: '摩羅上街  ·  Sheung Wan',
      lore: 'Long ago, when the British wizards first came to this city, sailors from across the sea brought their <span class="accent">forbidden goods</span> here to trade in shadow. They called the buyers "cats" - for they moved through alleys, took what was not theirs, and were never seen leaving. Today the stalls still stand, lined with jade and old bronze. Among them is something the dark one would burn the lane to find. <span class="accent">Get to it before he does.</span>',
      riddle: 'Walk to the heart of the lane where the antique stalls cluster thickest. Above the doorway of the central building, two digits mark the seal. Speak them.',
      password: '24',
      ddCongrats: "Well done, Miko Takeshi. The first seal yields — the cats of Sheung Wan kept their number for you alone. Far below the harbor, Harry stirred. He felt it. Now: each of the three of you must take what calls from these stalls. A stone. A coin. A bone trinket. Hold it. Name its power aloud. These are no muggle trinkets — these are the weapons that will arm you when the eighth hour comes.",
      dobbyDirections: 'Master Miko! Dobby is so pleased! Now Master must cross Hollywood Road — just up the stone stairs at the east end of the lane! The temple of the dragon-painted roof is waiting right there! It is 50 paces, no more! Hurry, Master!',
      next: 'manmo'
    },
    manmo: {
      tag: 'THE SECOND SACRED PLACE',
      title: 'Man Mo Temple',
      image: 'data:image/jpeg;base64,',
      mapNarration: "The second gate waits just up the stone stairs of Hollywood Road — the temple of letters and war, with its dragon-painted roof. Tap the new mark, Miko.",
      cn: '文武廟  ·  Hollywood Road',
      lore: 'Across the street, the gods of <span class="accent">letters and war</span> watch over Hollywood Road. Their hall was raised by wealthy merchants when this city was still young — wizards who knew the dark one would one day return. They left the year of their gathering at the threshold for any heir who could read it.',
      riddle: 'You stand at the gate of the gods of letters and war. They have watched over this lane since their hall was first raised. The year of their gathering is carved at the threshold. Four digits. Speak them.',
      password: '1847',
      ddCongrats: "The gods of letters and war have opened their hall to you, Miko Takeshi. The year 1847 was no accident — those merchants were wizards in hiding, and they raised this temple for a night exactly like tonight. As you spoke the year aloud, somewhere beneath the harbor, Hermione's chains loosened by a single link. She knows you are coming. Your three weapons have also been blessed in this place — a second charge sings in each of them now. But there is one more thing the gods of war taught their warriors: never fight on an empty stomach. Dobby has already arranged it. Take a taxi to Maxim's Palace at City Hall — eat well, Miko Takeshi. Every dish at this table is old kitchen-magic, and you will need it before the eighth hour.",
      dobbyDirections: 'Master, the meal has strengthened you well! Now take another taxi — to the Peak Tram lower terminus at 33 Garden Road! Say "Peak Tram lower terminus, Garden Road"! The cable carriage will lift Master to the highest seat in Hong Kong! Hurry, Master, the eighth hour grows near!',
      next: 'peak'
    },
    peak: {
      tag: 'THE THIRD SACRED PLACE',
