      cn: '鐘樓  ·  Tsim Sha Tsui',
      lore: 'The harbor\'s old station was destroyed long ago, but the wizards saved its <span class="accent">tower</span>. It still keeps time over the water. The plaque at its base names the year of its raising. Find it now — the eighth hour approaches.',
      riddle: 'The last tower of the old station has stood since the year of its raising. The plaque at its base names that year. Four digits. Speak them.',
      password: '1915',
      ddCongrats: "The final gate is open, Miko Takeshi. The Clock Tower of Tsim Sha Tsui was raised in 1915 by wizards who knew this night would come — and they aimed its hands at this very hour. Harry, Ron, and Hermione are listening now. They feel every seal you have broken tonight. Look upon the map: the dark one's mark has risen over Victoria Harbour. Walk to it. The lights are about to dance, and he is at his weakest in their dancing. End him before the eighth hour rings across the water.",
      next: null
    }
  };

  let CURRENT_STOP = null;
  let NEXT_STOP = 'cat'; // The stop the map should narrate to; updated as each is completed

  // --- PROGRESS PERSISTENCE ---
  // Save current scene + progress flags so a phone reload restores the user where they left off.
  const _PROGRESS_KEY = 'quest_progress_v1';
  function saveProgress(sceneId) {
    try {
      const data = {
        scene: sceneId || (document.querySelector('.scene.visible') || {}).id,
        currentStop: CURRENT_STOP,
        nextStop: NEXT_STOP,
        sortingDone: localStorage.getItem('quest_sorting_done') === '1',
        ts: Date.now()
      };
      localStorage.setItem(_PROGRESS_KEY, JSON.stringify(data));
    } catch (e) { /* localStorage may be full or disabled */ }
  }
  function restoreProgress() {
    try {
      const raw = localStorage.getItem(_PROGRESS_KEY);
      if (!raw) return false;
      const data = JSON.parse(raw);
      // Don't restore if last save was over 18 hours ago — quest is one-day
      if (Date.now() - (data.ts || 0) > 18 * 60 * 60 * 1000) {
        localStorage.removeItem(_PROGRESS_KEY);
        return false;
      }
      if (data.currentStop) CURRENT_STOP = data.currentStop;
      if (data.nextStop)    NEXT_STOP    = data.nextStop;
      // Restore pin states based on which stops have been completed
      const order = ['cat', 'manmo', 'peak', 'clock'];
      let lastDone = null;
      if (NEXT_STOP && NEXT_STOP !== 'cat' && NEXT_STOP !== 'final') {
        const idx = order.indexOf(NEXT_STOP);
        if (idx > 0) {
          for (let i = 0; i < idx; i++) {
            const pin = document.querySelector('.map-pin[data-stop="' + order[i] + '"]');
            if (pin) { pin.classList.remove('active', 'locked'); pin.classList.add('done'); }
            lastDone = order[i];
          }
          const cur = document.querySelector('.map-pin[data-stop="' + NEXT_STOP + '"]');
          if (cur) { cur.classList.remove('locked'); cur.classList.add('active'); cur.onclick = () => openStop(NEXT_STOP); }
        }
      } else if (NEXT_STOP === 'final') {
        order.forEach(s => {
          const pin = document.querySelector('.map-pin[data-stop="' + s + '"]');
          if (pin) { pin.classList.remove('active','locked'); pin.classList.add('done'); }
        });
        lastDone = 'clock';
      }
      // Move Miko marker to the last completed stop (where he physically is)
      if (lastDone) {
        const lastPin = document.querySelector('.map-pin[data-stop="' + lastDone + '"]');
        const marker = document.getElementById('mikoMarker');
        if (lastPin && marker) {
          marker.style.left = lastPin.style.left;
          marker.style.top = lastPin.style.top;
          marker.classList.remove('at-start');
        }
      }
      // Jump to last scene if it's not the cold open
      if (data.scene && data.scene !== 'scene-cold') {
        // Don't auto-restore battle or victory — let them re-trigger naturally
        const safe = ['scene-letter','scene-sorting','scene-rules','scene-map','scene-stop','scene-dimsum','scene-artifact','scene-countdown'];
        if (safe.indexOf(data.scene) !== -1) {
          // Friendly labels for the resume overlay
          const labels = {
            'scene-letter':    "Dumbledore's letter awaits",
            'scene-sorting':   'The Sorting Hat is ready',
            'scene-rules':     'The Laws of the Quest',
            'scene-map':       'Hong Kong is calling',
            'scene-stop':      'A sacred place stands open',
            'scene-dimsum':    "Dobby has saved your table",
            'scene-artifact':  'Your weapons await naming',
            'scene-countdown': 'The eighth hour approaches'
          };
          const t = document.getElementById('resumeTitle');
          if (t && labels[data.scene]) t.textContent = labels[data.scene];
          const ov = document.getElementById('resumeOverlay');
          if (ov) ov.style.display = 'flex';
          // Store the pending scene to jump to once user taps
          window._pendingRestoreScene = data.scene;
          return true;
        }
      }
      return true;
    } catch (e) {
      return false;
    }
  }
  function dismissResumeOverlay() {
    const ov = document.getElementById('resumeOverlay');
    if (!ov) return;
    ov.style.transition = 'opacity 0.4s ease';
    ov.style.opacity = '0';
    setTimeout(() => {
      ov.style.display = 'none';
      ov.style.opacity = '';
      ov.style.transition = '';
      // Now actually jump to the restored scene — this user-tap unlocks audio
      const target = window._pendingRestoreScene;
      if (target) {
        show(target);
        if (target === 'scene-letter') letterPage(1);
        delete window._pendingRestoreScene;
      }
    }, 400);
  }

  // Wipe progress (used internally on victory or by future reset button)
  function resetProgress() {
    try {
      localStorage.removeItem(_PROGRESS_KEY);
      localStorage.removeItem('quest_arsenal');
      localStorage.removeItem('quest_dimsum_hp');
      localStorage.removeItem('quest_sorting_done');
    } catch (e) {}
  }
  // Save automatically on page hide / unload
  window.addEventListener('pagehide', () => saveProgress());
  document.addEventListener('visibilitychange', () => { if (document.hidden) saveProgress(); });
  // Restore once DOM is ready
  document.addEventListener('DOMContentLoaded', () => {
    setTimeout(() => restoreProgress(), 100);
  });
  const FINAL_NARRATION = "Look — the dark one's mark has risen over Victoria Harbour. The lights are beginning to dance. Walk to the water, Miko Takeshi. He is waiting for you.";

  function updateMapNarration() {
    const txt = document.getElementById('mapNarrationText');
    if (!txt) return;
    if (NEXT_STOP === 'final' || !NEXT_STOP) {
      txt.textContent = FINAL_NARRATION;
      return;
    }
    if (STOPS[NEXT_STOP] && STOPS[NEXT_STOP].mapNarration) {
      txt.textContent = STOPS[NEXT_STOP].mapNarration;
      return;
    }
    txt.textContent = FINAL_NARRATION;
  }

  function openStop(stopId) {
    CURRENT_STOP = stopId;
    const s = STOPS[stopId];
    if (!s) return;
    document.getElementById('stopCardTag').textContent = s.tag;
    document.getElementById('stopCardTitle').textContent = s.title;
    document.getElementById('stopCardCn').textContent = s.cn;
    // Stop image — hide wrap if no URL or image fails to load
    const wrap = document.getElementById('stopImgWrap');
    const img = document.getElementById('stopCardImg');
    if (s.image) {
      wrap.style.display = 'block';
      img.onerror = () => { wrap.style.display = 'none'; };
      img.onload = () => { wrap.style.display = 'block'; };
      img.alt = s.title;
      img.src = s.image;
    } else {
      wrap.style.display = 'none';
    }
    document.getElementById('stopCardLore').innerHTML = s.lore;
    document.getElementById('stopCardRiddle').textContent = s.riddle;
    document.getElementById('passwordInput').value = '';
    document.getElementById('passwordFeedback').textContent = '';
    document.getElementById('stopSubmitBtn').onclick = () => checkPassword(stopId);
    show('scene-stop');
  }

  function checkPassword(stopId) {
    const s = STOPS[stopId];
    const inp = document.getElementById('passwordInput');
    const fb = document.getElementById('passwordFeedback');
    const val = (inp.value || '').trim().toUpperCase();
    if (val === s.password.toUpperCase()) {
      fb.textContent = 'The seal yields...';
      fb.className = 'password-feedback right';
      setTimeout(() => {
        showDDOverlay(s.ddCongrats);
      }, 900);
    } else {
      fb.textContent = 'The wind carries no echo. Try again.';
      fb.className = 'password-feedback wrong';
      inp.value = '';
      inp.focus();
    }
  }

  // --- DUMBLEDORE OVERLAY ---
  function showDDOverlay(speech) {
    document.getElementById('ddSpeech').textContent = speech;
    // Use the same Dumbledore portrait already embedded
    const existingPortrait = document.querySelector('.dumbledore-portrait, .dd-avatar');
    if (existingPortrait) {
      document.getElementById('ddBigPortrait').src = existingPortrait.src;
    }
    document.getElementById('ddOverlay').classList.add('show');
  }
  function closeDDOverlay() {
    document.getElementById('ddOverlay').classList.remove('show');
    // Clock Tower → straight to countdown/battle prep
    if (CURRENT_STOP === 'clock') {
      showCountdown();
      return;
    }
    // Man Mo → dim sum interlude at Maxim's Palace
    if (CURRENT_STOP === 'manmo') {
      openDimSum();
      return;
    }
    // Peak → straight to Dobby directions & map (no artifact collection)
    if (CURRENT_STOP === 'peak') {
      finishStop();
      return;
    }
    // Cat Street → artifact log (the ONLY shopping stop)
    document.getElementById('artifactStopTitle').textContent = STOPS[CURRENT_STOP].title;
    // Reset slots
    ['miko', 'michael', 'andrea'].forEach(p => {
      document.getElementById(p + 'Item').value = '';
      document.getElementById(p + 'Power').value = '';
      document.getElementById(p + 'Dmg').style.display = 'none';
      const submit = document.querySelector(`.artifact-slot[data-person="${p}"] .artifact-submit`);
      if (submit) {
        submit.disabled = false;
        submit.style.display = 'block';
        submit.textContent = 'LOCK IT IN';
      }
    });
    document.getElementById('artifactContinue').disabled = true;
    show('scene-artifact');
  }

  // --- ARTIFACT LOG ---
  const LOCKED = { miko: false, michael: false, andrea: false };

  function lockArtifact(person) {
    const item = document.getElementById(person + 'Item').value.trim();
    const power = document.getElementById(person + 'Power').value.trim();
    if (!item || !power) {
      alert('Both fields needed — what you chose AND its power name.');
      return;
    }
    // Assign damage 8-25, weighted to make some choices clearly stronger
    const dmg = 8 + Math.floor(Math.random() * 18);
    document.getElementById(person + 'DmgVal').textContent = dmg;
    document.getElementById(person + 'Dmg').style.display = 'block';
    const submit = document.querySelector(`.artifact-slot[data-person="${person}"] .artifact-submit`);
    submit.style.display = 'none';
    LOCKED[person] = true;
    // Wand spark burst + magical sound
    playSfx('magic', 0.6);
    const slot = document.querySelector('.artifact-slot[data-person="' + person + '"]');
    if (slot) {
      const burst = document.createElement('div');
      burst.className = 'wand-spark';
      burst.innerHTML = '<span>✦</span><span>✧</span><span>✦</span><span>✧</span><span>✦</span><span>✧</span>';
      slot.appendChild(burst);
      setTimeout(() => burst.remove(), 1500);
    }
    if (navigator.vibrate) navigator.vibrate([10, 20, 10]);
    // Save to localStorage as arsenal entry
    const arsenal = JSON.parse(localStorage.getItem('quest_arsenal') || '[]');
    arsenal.push({ stop: CURRENT_STOP, person, item, power, dmg });
    localStorage.setItem('quest_arsenal', JSON.stringify(arsenal));
    // Check all locked
    if (LOCKED.miko && LOCKED.michael && LOCKED.andrea) {
      document.getElementById('artifactContinue').disabled = false;
      // Reset for next stop
      Object.keys(LOCKED).forEach(k => LOCKED[k] = false);
    }
  }

  function finishStop() {
    const stop = STOPS[CURRENT_STOP];
    const next = stop.next;
    NEXT_STOP = next || 'final';
    // Mark current stop as done on map, unlock next
    document.querySelectorAll('.map-pin').forEach(pin => {
      if (pin.dataset.stop === CURRENT_STOP) {
        pin.classList.remove('active');
        pin.classList.add('done');
      }
      if (pin.dataset.stop === next) {
        pin.classList.remove('locked');
        pin.classList.add('active');
        pin.onclick = () => openStop(next);
      }
    });
    // Update done pin SVG (replace dragon seal with green check)
    // Done state is handled by CSS now (emoji + checkmark badge via .map-pin.done .pin-emoji::after)
    // Move Miko marker to the JUST COMPLETED stop (where he physically IS now)
    const justDonePin = document.querySelector(`.map-pin[data-stop="${CURRENT_STOP}"]`);
    const marker = document.getElementById('mikoMarker');
    if (justDonePin && marker) {
      marker.style.left = justDonePin.style.left;
      marker.style.top = justDonePin.style.top;
      marker.classList.remove('at-start');
    }
    // Show Dobby overlay with directions, THEN go to map when user dismisses
    if (stop.dobbyDirections) {
      showDobbyOverlay(stop.dobbyDirections);
    } else {
      show('scene-map');
      updateMapNarration();
    }
  }

  // --- DIM SUM AT MAXIM'S PALACE ---
  const DIM_SUM_DISHES = [
    // — Tier S: absolute icons —
    { id: 'hargow',   emoji: '🥟', name: 'Har Gow',          cn: '蝦餃',   hp: 6,  blurb: 'crystal-skin shrimp dumplings', img: 'data:image/jpeg;base64,' },
    { id: 'siumai',   emoji: '🍢', name: 'Siu Mai',          cn: '燒賣',   hp: 6,  blurb: 'pork & shrimp open-tops', img: 'data:image/jpeg;base64,'  },
    { id: 'cha_siu',  emoji: '🍞', name: 'Char Siu Bao',     cn: '叉燒包', hp: 8,  blurb: 'pillowy BBQ pork buns', img: 'data:image/jpeg;base64,'  },
    { id: 'cheung',   emoji: '🍣', name: 'Cheung Fun',       cn: '腸粉',   hp: 7,  blurb: 'silky rice rolls in sweet soy', img: 'data:image/jpeg;base64,'  },
    { id: 'egg_tart', emoji: '🥧', name: 'Egg Tart',         cn: '蛋撻',   hp: 8,  blurb: 'flaky crust, silken egg', img: 'data:image/jpeg;base64,'  },
    // — Tier A: the heroes —
    { id: 'liu_sha',  emoji: '🟡', name: 'Lava Custard Bun', cn: '流沙包', hp: 12, blurb: 'molten salted-yolk custard', img: 'data:image/jpeg;base64,'  },
    { id: 'lo_mai',   emoji: '🍙', name: 'Lo Mai Gai',       cn: '糯米雞', hp: 10, blurb: 'sticky rice in lotus leaf', img: 'data:image/jpeg;base64,'  },
    { id: 'pai_gwat', emoji: '🍖', name: 'Steamed Spare Ribs', cn: '排骨',   hp: 7,  blurb: 'pork ribs in black bean sauce', img: 'data:image/jpeg;base64,'  },
    { id: 'lo_bak',   emoji: '🟫', name: 'Turnip Cake',      cn: '蘿蔔糕', hp: 7,  blurb: 'pan-fried radish cake', img: 'data:image/jpeg;base64,'  },
    { id: 'wu_gok',   emoji: '🟣', name: 'Taro Puff',        cn: '芋角',   hp: 9,  blurb: 'crispy lattice, taro inside', img: 'data:image/jpeg;base64,'  },
    { id: 'cha_sou',  emoji: '🥐', name: 'BBQ Pork Pastry',  cn: '叉燒酥', hp: 8,  blurb: 'flaky char siu in puff pastry', img: 'data:image/jpeg;base64,'  },
    { id: 'ngau_yuk', emoji: '🍡', name: 'Beef Meatballs',   cn: '牛肉球', hp: 6,  blurb: 'steamed beef on bean curd skin', img: 'data:image/jpeg;base64,'  },
    { id: 'fung_zaau',emoji: '🐔', name: 'Chicken Feet',     cn: '鳳爪',   hp: 6,  blurb: 'the dare. spicy black bean', img: 'data:image/jpeg;base64,'  },
    // — Sweets to finish —
    { id: 'mango',    emoji: '🥭', name: 'Mango Pudding',    cn: '芒果布甸', hp: 5,  blurb: 'cold, sweet, dessert classic', img: 'data:image/jpeg;base64,'  },
    { id: 'jin_deui', emoji: '🍩', name: 'Sesame Ball',      cn: '煎堆',   hp: 7,  blurb: 'fried glutinous rice + sesame', img: 'data:image/jpeg;base64,'  },
    { id: 'ma_lai',   emoji: '🧁', name: 'Ma Lai Go',        cn: '馬拉糕', hp: 5,  blurb: 'steamed brown-sugar sponge cake', img: 'data:image/jpeg;base64,'  }
  ];
  const EATEN_DISHES = new Set();
  let DIM_SUM_HP_BONUS = 0;

  function openDimSum() {
    EATEN_DISHES.clear();
    DIM_SUM_HP_BONUS = 0;
    document.getElementById('dimsumHpTotal').textContent = '0';
    document.getElementById('dimsumFinishBtn').disabled = true;
    document.getElementById('dimsumHint').textContent = 'Tap at least one dish to continue. The more you eat, the longer you stand against him.';
    // Pull Dobby's portrait from the dobby-corner element (already embedded as base64)
    const dobbyImg = document.querySelector('.dobby-sprite, #dobbyCorner img');
    const dPortrait = document.getElementById('dimsumDobbyPortrait');
    if (dPortrait && dobbyImg && dobbyImg.src) dPortrait.src = dobbyImg.src;
    const grid = document.getElementById('dimsumGrid');
    grid.innerHTML = '';
    DIM_SUM_DISHES.forEach(d => {
      const card = document.createElement('div');
      card.className = 'dish-card';
      card.dataset.id = d.id;
      const visual = d.img
        ? `<img class="dish-img" src="${d.img}" alt="${d.name}">`
        : `<span class="dish-emoji">${d.emoji}</span>`;
      card.innerHTML = `
        ${visual}
        <div class="dish-name">${d.name}</div>
        <div class="dish-cn">${d.cn}</div>
        <div class="dish-hp">+${d.hp} ❤</div>
      `;
      card.onclick = () => eatDish(d, card);
      grid.appendChild(card);
    });
    show('scene-dimsum');
  }

  function eatDish(dish, card) {
    if (EATEN_DISHES.has(dish.id)) return;
    EATEN_DISHES.add(dish.id);
    DIM_SUM_HP_BONUS += dish.hp;
    card.classList.add('eaten');
    document.getElementById('dimsumHpTotal').textContent = String(DIM_SUM_HP_BONUS);
    // Floating +HP popup
    const popup = document.createElement('div');
    popup.className = 'hp-popup';
    popup.textContent = '+' + dish.hp;
    const rect = card.getBoundingClientRect();
    popup.style.left = (rect.left + rect.width / 2 - 20) + 'px';
    popup.style.top = (rect.top + 10) + 'px';
    popup.style.position = 'fixed';
    popup.style.zIndex = '9999';
    document.body.appendChild(popup);
    setTimeout(() => popup.remove(), 950);
    // Enable finish button
    document.getElementById('dimsumFinishBtn').disabled = false;
    const ate = EATEN_DISHES.size;
    document.getElementById('dimsumHint').textContent = ate === DIM_SUM_DISHES.length
      ? 'You have eaten everything Dobby asked for. Your strength is at its peak.'
      : `${ate} of ${DIM_SUM_DISHES.length} dishes eaten — keep going, Master.`;
  }

  function finishDimSum() {
    if (DIM_SUM_HP_BONUS <= 0) return;
    localStorage.setItem('quest_dimsum_hp', String(DIM_SUM_HP_BONUS));
    finishStop();
  }

  // --- DOBBY OVERLAY ---
  function showDobbyOverlay(speech) {
    document.getElementById('dobbySpeech').textContent = speech;
    // Use the Dobby image already embedded in the corner
    const dobbyImg = document.querySelector('.dobby-sprite');
    if (dobbyImg) {
      document.getElementById('dobbyBigPortrait').src = dobbyImg.src;
    }
    document.getElementById('dobbyOverlay').classList.add('show');
  }
  function closeDobbyOverlay() {
    document.getElementById('dobbyOverlay').classList.remove('show');
    show('scene-map');
    updateMapNarration();
  }

  // --- COUNTDOWN + BATTLE ---
  let countdownTimer = null;
  function showCountdown() {
    show('scene-countdown');
    // Show real time countdown to 8 PM today (or just show 8:00 PM static if past 8)
    function tick() {
      const now = new Date();
      const eight = new Date();
      eight.setHours(20, 0, 0, 0);
      let diff = eight - now;
      if (diff <= 0) {
        // Past 8 PM - enable the button immediately
        document.getElementById('countdownClock').textContent = '08:00';
        document.getElementById('countdownInstruction').textContent = 'The eighth hour has come. The lights stir across the harbor. Tap below — face him now.';
        clearInterval(countdownTimer);
        return;
      }
      const mins = Math.floor(diff / 60000);
      const secs = Math.floor((diff % 60000) / 1000);
      // Show as time-until-8pm
      const hh = Math.floor(mins / 60);
      const mm = mins % 60;
      document.getElementById('countdownClock').textContent =
        String(hh).padStart(2,'0') + ':' + String(mm).padStart(2,'0') + ':' + String(secs).padStart(2,'0');
    }
    tick();
    if (countdownTimer) clearInterval(countdownTimer);
    countdownTimer = setInterval(tick, 1000);
  }

  // --- BATTLE ENGINE ---
  let VOLD_HP = 200;
  let VOLD_HP_MAX = 200;
  let HERO_HP = 120;
  let HERO_HP_MAX = 120;
  let battleArsenal = [];
  let battleLocked = false;

  const VOLD_ATTACKS = [
    { name: 'Avada Kedavra', dmg: [10, 14] },
    { name: 'Crucio', dmg: [8, 11] },
    { name: 'Sectumsempra', dmg: [7, 10] },
    { name: 'Dark Mark Lash', dmg: [5, 8] },
    { name: 'Imperio', dmg: [6, 9] },
    { name: 'Death Eater Bolt', dmg: [4, 7] },
    { name: 'Bone-Shatter Hex', dmg: [6, 10] },
    { name: 'Serpentine Strike', dmg: [5, 9] },
  ];
  function startBattle() {
    if (countdownTimer) clearInterval(countdownTimer);
    show('scene-battle');
    startBattleMusic();
    // Voldemort laughs as he appears — dramatic entrance
    setTimeout(() => playSfx('laugh', 0.8), 600);
    // Pull arsenal from localStorage
    battleArsenal = JSON.parse(localStorage.getItem('quest_arsenal') || '[]');
    // If empty (testing), seed with demo data
    if (battleArsenal.length === 0) {
      // Fallback: 3 weapons (one per person), all from Cat Street — matches Option A flow
      battleArsenal = [
        { stop: 'cat', person: 'miko',    item: 'Jade dragon pendant', power: "Dragon's Breath", dmg: 22 },
        { stop: 'cat', person: 'michael', item: 'Bronze coin',         power: "Lion's Roar",     dmg: 18 },
        { stop: 'cat', person: 'andrea',  item: 'Old jade mask',       power: 'Veil of Truth',   dmg: 20 },
      ];
    }
    // Each artifact has 3 charges (one per sacred place still to come)
    battleArsenal.forEach(a => { a.uses = 3; a.used = false; });
    // Total HP scaled to sum of (damage × charges) × 0.55 so they need most but not every strike
    const total = battleArsenal.reduce((s, a) => s + a.dmg * a.uses, 0);
    VOLD_HP_MAX = Math.max(80, Math.round(total * 0.55));
    VOLD_HP = VOLD_HP_MAX;
    // Hero HP scales modestly with arsenal size + any dim sum HP bonus earned at Maxim's Palace
    const dimsumBonus = parseInt(localStorage.getItem('quest_dimsum_hp') || '0', 10) || 0;
    HERO_HP_MAX = 100 + battleArsenal.length * 4 + dimsumBonus;
    HERO_HP = HERO_HP_MAX;
    battleLocked = false;
    updateVoldHp();
    updateHeroHp();
    renderMoves();
    document.getElementById('battleStatus').innerHTML = '<span style="color:var(--gold-bright);">Tap a power to strike. Stronger powers deal more damage.</span>';
    // Reset sprite if previously defeated
    const sprite = document.getElementById('voldSprite');
    sprite.classList.remove('hit', 'defeated', 'casting');
    sprite.style.display = 'block';
    sprite.style.opacity = '1';
    sprite.style.transform = '';
    sprite.style.filter = '';
    const deadSprite = document.getElementById('voldSpriteDead');
    deadSprite.classList.remove('showing');
    deadSprite.style.display = 'none';
  }

  function renderMoves() {
    const grid = document.getElementById('movesGrid');
    grid.innerHTML = '';
    battleArsenal.forEach((m, idx) => {
      const btn = document.createElement('button');
      btn.className = 'move-btn ' + m.person;
      btn.dataset.idx = idx;
      const usesLeft = (m.uses == null) ? 1 : m.uses;
      btn.disabled = usesLeft <= 0;
      btn.innerHTML = `
        <div class="move-who">${m.person.toUpperCase()}</div>
        <div class="move-name">${escapeHtml(m.power)}</div>
        <div class="move-dmg">${m.dmg} dmg · ${usesLeft} ✦</div>
      `;
      btn.onclick = () => useMove(idx);
      grid.appendChild(btn);
    });
  }
  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }

  function updateVoldHp() {
    const pct = Math.max(0, VOLD_HP / VOLD_HP_MAX * 100);
    document.getElementById('voldHpFill').style.width = pct + '%';
    document.getElementById('voldHpText').textContent = Math.max(0, VOLD_HP) + ' / ' + VOLD_HP_MAX;
  }

  function updateHeroHp() {
    const pct = Math.max(0, HERO_HP / HERO_HP_MAX * 100);
    const fill = document.getElementById('heroHpFill');
    fill.style.width = pct + '%';
    fill.classList.remove('low', 'critical');
    if (pct < 25) fill.classList.add('critical');
    else if (pct < 50) fill.classList.add('low');
    document.getElementById('heroHpText').textContent = Math.max(0, HERO_HP) + ' / ' + HERO_HP_MAX;
  }

  function useMove(idx) {
    if (battleLocked) return;
    const m = battleArsenal[idx];
    if (m.uses == null) m.uses = 1;
    if (m.uses <= 0) return;
    m.uses -= 1;
    battleLocked = true;
    VOLD_HP -= m.dmg;
    updateVoldHp();
    // Damage popup
    const wrap = document.getElementById('voldSpriteWrap');
    const popup = document.createElement('div');
    popup.className = 'damage-popup';
    popup.textContent = '-' + m.dmg;
    popup.style.left = (40 + Math.random() * 100) + 'px';
    popup.style.top = (60 + Math.random() * 40) + 'px';
    wrap.appendChild(popup);
    setTimeout(() => popup.remove(), 1300);
    // Sprite shake + haptic kick + sword swoosh
    const sprite = document.getElementById('voldSprite');
    sprite.classList.add('hit');
    setTimeout(() => sprite.classList.remove('hit'), 400);
    if (navigator.vibrate) navigator.vibrate([20, 30, 60]);  // satisfying triple-thump
    playSfx('sword', 0.75);
    // Status
    document.getElementById('battleStatus').innerHTML =
      '<span style="color:var(--parchment);"><b style="color:var(--gold-bright)">' + escapeHtml(m.power) +
      '</b> strikes for <b style="color:var(--crimson)">' + m.dmg + '</b>!</span>';
    renderMoves();
    // Check victory FIRST
    if (VOLD_HP <= 0) {
      document.getElementById('battleStatus').innerHTML =
        '<span style="color:var(--gold-bright); font-size:14px;"><b>The dark one falters! The lights take him!</b></span>';
      sprite.classList.add('defeated');
      playSfx('finish', 0.85);
      if (navigator.vibrate) navigator.vibrate([200, 80, 200, 80, 400]);
      // After alive sprite dissolves, show dead sprite emerging
      setTimeout(() => {
        sprite.style.display = 'none';
        const dead = document.getElementById('voldSpriteDead');
        dead.style.display = 'block';
        dead.classList.add('showing');
      }, 1500);
      setTimeout(victoryScene, 4500);
      return;
    }
    // Voldemort counter-attacks
    setTimeout(voldemortAttack, 1100);
  }

  function voldemortAttack() {
    if (VOLD_HP <= 0) return;
    const atk = VOLD_ATTACKS[Math.floor(Math.random() * VOLD_ATTACKS.length)];
    const dmg = atk.dmg[0] + Math.floor(Math.random() * (atk.dmg[1] - atk.dmg[0] + 1));
    // Sprite cast animation
    const sprite = document.getElementById('voldSprite');
    sprite.classList.add('casting');
    setTimeout(() => sprite.classList.remove('casting'), 600);
    // Screen flash + harsh haptic + impact sound
    const flash = document.getElementById('voldCastFlash');
    flash.classList.remove('active');
    void flash.offsetWidth; // restart animation
    flash.classList.add('active');
    if (navigator.vibrate) navigator.vibrate([80, 40, 120]);  // ominous double-thump
    playSfx('gun', 0.7);
    // Show damage popup near hero bar
    setTimeout(() => {
      const heroRow = document.querySelector('.hero-hp-row');
      const rect = heroRow.getBoundingClientRect();
      const popup = document.createElement('div');
      popup.className = 'hero-dmg-popup';
      popup.textContent = '-' + dmg;
      popup.style.left = (rect.left + rect.width / 2) + 'px';
      popup.style.top = (rect.top - 8) + 'px';
      document.body.appendChild(popup);
      setTimeout(() => popup.remove(), 1500);
      // HARD CAP: Miko cannot lose. Hero HP never drops below 1.
      const newHp = HERO_HP - dmg;
      if (newHp <= 0) {
        HERO_HP = 1;
        updateHeroHp();
        document.getElementById('battleStatus').innerHTML =
          '<span style="color:var(--gold-bright);"><i>"Hold steady, Miko — your friends are with you!" Dumbledore\'s voice rings through your mind. You will not fall.</i></span>';
      } else {
        HERO_HP = newHp;
        updateHeroHp();
        document.getElementById('battleStatus').innerHTML =
          '<span style="color:#ff8a8a;"><b style="color:#ff5252;">VOLDEMORT</b> casts <b>' + escapeHtml(atk.name) +
          '</b> for <b style="color:#ff5252;">' + dmg + '</b>!</span>';
      }
      battleLocked = false;
    }, 350);
  }

  function victoryScene() {
    stopBattleMusic(true);
    const ddImg = document.querySelector('.dumbledore-portrait, .dd-avatar');
    if (ddImg) document.getElementById('victoryDdPortrait').src = ddImg.src;
    // Populate the curtain call with the three sorted photos
    if (typeof SORTING_IMGS !== 'undefined') {
      const m = document.getElementById('curtainMiko');
      const mc = document.getElementById('curtainMichael');
      const an = document.getElementById('curtainAndrea');
      if (m)  m.src  = SORTING_IMGS.miko_sorted;
      if (mc) mc.src = SORTING_IMGS.michael_sorted;
      if (an) an.src = SORTING_IMGS.andrea_sorted;
    }
    show('scene-victory');
  }

  // ====== DEV SKIP — REMOVE BEFORE GIVING TO MIKO ======
  // DEMO_ARSENAL = 3 weapons (one per person), all collected at Cat Street per Option A
  const DEMO_ARSENAL = [
    { stop: 'cat', person: 'miko',    item: 'Jade dragon pendant', power: "Dragon's Breath", dmg: 22 },
    { stop: 'cat', person: 'michael', item: 'Bronze coin',         power: "Lion's Roar",     dmg: 18 },
    { stop: 'cat', person: 'andrea',  item: 'Old jade mask',       power: 'Veil of Truth',   dmg: 20 },
  ];

  function devSkip(target) {
    // Hide overlays
    document.getElementById('ddOverlay').classList.remove('show');
    document.getElementById('dobbyOverlay').classList.remove('show');
    if (countdownTimer) clearInterval(countdownTimer);

    if (target === 'letter') { show('scene-letter'); letterPage(1); return; }
    if (target === 'sorting') { openSorting(); return; }
    if (target === 'rules') { show('scene-rules'); return; }
    if (target === 'map') {
      // Make sure all map pins are visible (active for first, locked others)
      show('scene-map');
      updateMapNarration();
      return;
    }
    if (target === 'cat' || target === 'manmo' || target === 'peak' || target === 'clock') {
      CURRENT_STOP = target;
      NEXT_STOP = target;
      openStop(target);
      // Pre-fill correct password
      setTimeout(() => {
        document.getElementById('passwordInput').value = STOPS[target].password;
      }, 100);
      return;
    }
    if (target === 'dimsum') {
      CURRENT_STOP = 'manmo';
      NEXT_STOP = 'manmo';
      openDimSum();
      return;
    }
    if (target === 'artifact') {
      CURRENT_STOP = 'cat';
      NEXT_STOP = 'cat';
      document.getElementById('artifactStopTitle').textContent = 'Cat Street';
      ['miko', 'michael', 'andrea'].forEach((p, i) => {
        document.getElementById(p + 'Item').value = DEMO_ARSENAL[i].item;
        document.getElementById(p + 'Power').value = DEMO_ARSENAL[i].power;
        document.getElementById(p + 'Dmg').style.display = 'none';
        const submit = document.querySelector(`.artifact-slot[data-person="${p}"] .artifact-submit`);
        if (submit) { submit.disabled = false; submit.style.display = 'block'; }
      });
      document.getElementById('artifactContinue').disabled = true;
      show('scene-artifact');
      return;
    }
    if (target === 'countdown') {
      showCountdown();
      return;
    }
    if (target === 'battle') {
      localStorage.setItem('quest_arsenal', JSON.stringify(DEMO_ARSENAL));
      startBattle();
      return;
    }
    if (target === 'victory') {
      victoryScene();
      return;
    }
  }
  // ====== END DEV SKIP ======

  // Init
  startCold();
</script>

</body>
</html>
